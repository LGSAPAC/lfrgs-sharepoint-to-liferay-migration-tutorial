# Copy to .env and fill in. Never commit .env.

# --- Source platform ------------------------------------------------------------
# "online" (SharePoint Online, default) or "server" (SharePoint Server Subscription Edition)
SP_PLATFORM=online

# --- SharePoint Online / Microsoft Entra ID ---------------------------------
# Tenant ID (GUID) or primary domain, e.g. contoso.onmicrosoft.com
SP_TENANT_ID=
# Application (client) ID of the Entra app registration (see docs/01-prerequisites.md)
SP_CLIENT_ID=
# Root SharePoint host, e.g. contoso.sharepoint.com
SP_HOSTNAME=contoso.sharepoint.com
# Full URL of the site to migrate
SP_SITE_URL=https://contoso.sharepoint.com/sites/marketing

# Auth mode: "device_code" (delegated, default) or "certificate" (app-only).
# "none" only for the mock SharePoint (docs/14-mock-sharepoint.md), with SP_GRAPH_URL pointing at it.
SP_AUTH_MODE=device_code
# SP_GRAPH_URL=https://graph.microsoft.com/v1.0
# Only for SP_AUTH_MODE=certificate
SP_CERT_PATH=
SP_CERT_THUMBPRINT=

# --- SharePoint Server (SP_PLATFORM=server) -------------------------------------
# NTLM sign-in as a site collection administrator. SP_TENANT_ID / SP_CLIENT_ID aren't used.
# SP_USERNAME=CONTOSO\migration
# SP_PASSWORD=

# --- Liferay DXP 2026.Q3 -----------------------------------------------------
LIFERAY_URL=http://localhost:8080
# Dedicated migration administrator (Basic auth). For production, prefer OAuth 2.0.
LIFERAY_USER=test@liferay.com
LIFERAY_PASSWORD=learn
# base64("LIFERAY_USER:LIFERAY_PASSWORD"), used by .mcp.json for the Liferay MCP server
LIFERAY_BASIC=dGVzdEBsaWZlcmF5LmNvbTpsZWFybg==
# Default language for i18n fields
LIFERAY_LOCALE=en_US

# --- Migration ---------------------------------------------------------------
# Working directory for extracted data, plans and reports
SP2LR_OUT=./out
